# Copiar este archivo a .env y completar valores distintos.
# No subir las credenciales reales al repositorio.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require"
GEMINI_API_KEY="CONFIGURAR_CLAVE_DE_GEMINI"
OVERPASS_CONTACT="correo-valido@dominio.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REEMPLAZAR_CON_CONTRASENA_ALEATORIA_LARGA"
SYNC_API_TOKEN="REEMPLAZAR_CON_TOKEN_ALEATORIO_DISTINTO"
SYNC_API_URL="http://localhost:3000/api/sync"
SYNC_CRON="0 6 * * *"
SYNC_TIMEZONE="America/Argentina/Tucuman"

# Modelo Gemini opcional.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Exclusivo para Vercel Cron en Production (distinto de SYNC_API_TOKEN)
CRON_SECRET="REEMPLAZAR_CON_TOKEN_ALEATORIO_EXCLUSIVO_CRON"

# Habilitar únicamente si DATABASE_URL apunta a una base Preview aislada.
ALLOW_PREVIEW_WRITES="false"
