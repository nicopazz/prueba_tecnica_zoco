generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Venue {
  id                String      @id @default(cuid())
  originalName      String
  normalizedName    String?
  location          String
  category          String?
  source            String
  confidence        Int?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  slug              String?     @unique
  city              String?
  address           String?
  latitude          Float?
  longitude         Float?
  description       String?
  phone             String?
  whatsapp          String?
  instagram         String?
  website           String?
  openingHours      String?
  isFeatured        Boolean     @default(false)
  publicationStatus String      @default("DRAFT")
  reviewStatus      String      @default("PENDING")
  lastReviewedAt    DateTime?
  coordinateSource  String?
  images            VenueImage[]

  @@unique([normalizedName, location])
  @@index([publicationStatus, isActive])
  @@index([city, category])
}

model VenueImage {
  id          String   @id @default(cuid())
  venueId     String
  imageUrl    String
  publicId    String?
  alt         String?
  sortOrder   Int      @default(0)
  sourceUrl   String?
  attribution String?
  license     String?
  createdAt   DateTime @default(now())
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([venueId, sortOrder])
}

model SyncRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String
  triggeredBy   String
  foundCount    Int       @default(0)
  createdCount  Int       @default(0)
  updatedCount  Int       @default(0)
  conflictCount Int       @default(0)
  warnings      Json?
  errorMessage  String?
}
